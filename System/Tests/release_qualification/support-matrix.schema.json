{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.invalid/schemas/release-support-matrix-v1.json",
  "title": "Personal AI OS release qualification support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "sources"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "$ref": "#/$defs/release"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/release"
          },
          {
            "type": "object",
            "required": ["id", "disposition"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "disposition": {
                "enum": [
                  "candidate-direct",
                  "candidate-anchor",
                  "candidate-bridge",
                  "rescue",
                  "not-supported"
                ]
              },
              "fixture_mode": {
                "enum": ["clean-git", "no-git"],
                "default": "clean-git"
              },
              "accepted_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "default": []
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "required": ["ref", "commit", "version"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    }
  }
}
